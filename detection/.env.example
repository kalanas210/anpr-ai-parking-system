# ANPR AI Parking System - detection service environment
# Copy this file to `.env` (same folder) and fill in your own values.
# NEVER commit the real .env file.

# --- MongoDB Atlas ---
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
DB_NAME=parking_system

# --- Camera (RTSP live mode) ---
# rtsp://<user>:<password>@<host>:554/Streaming/Channels/101
RTSP_URL=
# Leave VIDEO_SOURCE empty to use RTSP_URL, or set a local file path for video/demo mode
VIDEO_SOURCE=

# --- AI services ---
OPENAI_API_KEY=
ROBOFLOW_API_KEY=
LICENSE_PLATE_MODEL_ID=license-plate-recognition-rxg4e/11

# --- Web server ---
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
# Optional: set a fixed Flask session secret (otherwise a random one is generated)
FLASK_SECRET_KEY=

# --- P10 LED display (ESP32 on your LAN) ---
P10_ENABLED=true
ESP32_IP=192.168.8.130
ESP32_KEY=uom

# --- Logging ---
LOG_LEVEL=INFO
