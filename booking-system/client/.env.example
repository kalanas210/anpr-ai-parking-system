# Booking system - client (React) environment
# Copy this file to `.env` (same folder) and fill in your own values.
# Only REACT_APP_* variables are exposed to the browser - never put secret keys here.

# Backend API base URL
REACT_APP_API_URL=http://localhost:5001/api

# Stripe PUBLISHABLE key only (safe for the browser)
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Environment
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# Feature flags (optional)
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_NOTIFICATIONS=true
