# Booking system - server environment
# Copy this file to `.env` (same folder) and fill in your own values.
# NEVER commit the real .env file.

# --- Server ---
PORT=5001
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the React client dev server)
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# --- Auth ---
# Use a long, random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
STRIPE_PUBLISH_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SMS gateway (ozonedesk) - optional ---
SMS_BASE_URL=http://sms.ozonedesk.com/api/v1/send.php
SMS_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Email (optional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
